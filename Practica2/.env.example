# Keycloak configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_URL_INTERNAL=http://keycloak:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# OAuth 2.0 / OIDC POC configuration
OAUTH_REALM=oauth-realm
OAUTH_CLIENT_ID=oauth-client
OAUTH_CLIENT_SECRET=oauth-client-secret-12345
OAUTH_FRONTEND_URL=http://localhost:3000
OAUTH_BACKEND_URL=http://localhost:8000

# SAML 2.0 POC configuration
SAML_REALM=saml-realm
SAML_FRONTEND_URL=http://localhost:3001
SAML_BACKEND_URL=http://localhost:8001
SAML_ENTITY_ID=http://localhost:8001/saml/metadata
SAML_ACS_URL=http://localhost:8001/saml/acs
